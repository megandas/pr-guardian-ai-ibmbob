{
  "name": "pr-guardian-ai",
  "displayName": "PR Guardian AI",
  "description": "AI PR Reviewer using IBM Bob",
  "version": "0.0.1",

  "engines": {
    "vscode": "^1.102.0"
  },

  "categories": [
    "Other"
  ],

  "activationEvents": [
    "onView:prguardianView",
    "onCommand:pr-guardian-ai.showArchitecture"
  ],

  "main": "./out/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "pr-guardian-ai.showArchitecture",
        "title": "PR Guardian AI: Show Repository Architecture",
        "category": "PR Guardian AI"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "prguardian-sidebar",
          "title": "PR Guardian AI",
          "icon": "media/icon.svg"
        }
      ]
    },

    "views": {
      "prguardian-sidebar": [
        {
          "type": "webview",
          "id": "prguardianView",
          "name": "Review Pull Request",
          "icon": "media/icon.svg"
        }
      ]
    },

    "menus": {
      "commandPalette": [
        {
          "command": "pr-guardian-ai.showArchitecture"
        }
      ]
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },

  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },

  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}